# Copiá este archivo a ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" a GitHub (contiene una credencial secreta).

# Access Token de PRUEBA (sandbox) que te da Mercado Pago Developers.
# Panel: Tus integraciones > tu app > Pruebas > Credenciales de prueba.
# OJO (cambio 2025): hoy también empieza con APP_USR-, igual que producción.
# Lo que distingue prueba vs producción es LA SECCIÓN, no el prefijo.
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# test = sandbox sin plata real (para el colegio). production = cobro REAL.
MP_ENV=test

# URL donde corre tu frontend. Como el backend sirve el frontend solo,
# dejalo en http://localhost:3000 y abrí http://localhost:3000/index.html
FRONTEND_URL=http://localhost:3000
